generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id               String     @id @default(cuid())
  fullName         String
  email            String     @unique
  currentStep      Int        @default(1)
  phone            String?    @unique
  encryptedPan     String?
  encryptedBankAcc String?
  encryptedIfsc    String?

  bankAccountType  String?     // savings or current
  bankName         String?     // Bank name from penny drop
  bankBranchName   String?     // Branch name
  bankAccountHolderName String? // Account holder name
  bankVerified     Boolean     @default(false)  // Whether bank was verified via penny drop
  bankVerifiedAt   DateTime?   // Timestamp of bank verification
  bankBeneficiaryName String?  // Name returned by bank
  bankNameMatchScore Int?      // Fuzzy match score (0-100)
  
  upiId            String?      // UPI ID (if provided)
  dob              DateTime?    // Date of Birth
  maritalStatus    MaritalStatus?      // e.g. "Single", "Married"
  education        EducationLevel?      // Highest education level
  motherName       String?
  fatherName       String?
  gender           Gender?
  annualIncome    AnnualIncome?
  incomeSource    IncomeSource?
  taxResidency    TaxResidency?
  residentialStatus ResidentialStatus?
  occupationType   OccupationType?
  countryOfBirth   String?      // Country of birth
  nationality      String?      // Nationality

  signatureUrl   String?      // S3 URL of signature image


  nomineeName         String?
  nomineeRelation     String?      // SPOUSE, CHILD, FATHER, MOTHER, OTHER
  nomineeAllocation   Float?       // Percentage allocation (0-100)
  nomineeIdType       String?      // PAN, AADHAAR, DRIVING_LICENCE, PASSPORT
  nomineeIdNumber     String?      // Full PAN or last 4 of Aadhaar or full DL/Passport
  nomineeEmail        String?
  nomineeMobile       String?
  nomineeAddressLine1 String?
  nomineeAddressLine2 String?
  nomineeCity         String?
  nomineePincode      String?
  nomineeCountry      String?
  nomineeDob          DateTime?
  
  languagePref     String?      // "en" or "hi"
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  kycStatus        KycStatus   @default(PENDING)
  // DigiLocker KYC Data (NEW FIELDS)
  digilockerKycId  String?      @unique  // DigiLocker session/KYC tracking ID
  digilockerid     String?      @unique  // 36-char unique DigiLocker user ID
  aadhaarLinked    Boolean      @default(false) // Whether Aadhaar is linked
  aadhaarLastFour  String?      // Last 4 digits of Aadhaar (masked)
  kycVerifiedAt    DateTime?    // Timestamp of KYC verification
  
  // Address from Aadhaar (extracted from DigiLocker)
  addressLine1     String?      // House number, building
  addressLine2     String?      // Street, locality
  city             String?      // City/Town/Village
  state            String?      // State
  pincode          String?      // PIN code
  country          String?      @default("India")

  // DigiLocker tokens (encrypted in production)
  dlAccessToken    String?      // DigiLocker access token
  dlRefreshToken   String?      // DigiLocker refresh token  
  dlTokenExpiresAt DateTime?    // Token expiry timestamp

  ckycRefId        String?      // CKYC reference after PAN verification
  kycType          KycType?     // VALIDATED, REGISTERED, ON_HOLD
  kraVerified      Boolean      @default(false) // KRA verification status

  fatcaDeclaration Json?        // e.g. JSON of FATCA form answers
  // Relations
  sips             SIP[]
  investments      Investment[]
  payments         Payment[]
  kycSessions      KycSession[]
}
model KycSession {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  state           String   @unique  // OAuth state parameter (CSRF protection)
  codeVerifier    String   // PKCE code verifier
  
  status          KycSessionStatus @default(INITIATED)
  errorCode       String?
  errorMessage    String?
  
  createdAt       DateTime @default(now())
  expiresAt       DateTime // Session expiry (10 minutes)
  
  @@index([userId])
  @@index([state])
}
model SIP {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  fundName         String
  amcCode          String
  schemeCode       String
  amountPerInstallment Float
  totalInstallments Int
  frequency        SIPFrequency
  startDate        DateTime
  nextInstallment  DateTime?
  endDate          DateTime?
  status           SIPStatus @default(ACTIVE)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  investments      Investment[]
}

model Investment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  sipId           String?  // null for one-time lump sum
  sip             SIP?     @relation(fields: [sipId], references: [id])
  fundName        String
  amcCode         String
  schemeCode      String
  units           Float
  navAtPurchase   Float
  currentNav      Float?
  type            InvestmentType // SIP or Lumpsum
  status          InvestmentStatus
  purchaseDate    DateTime
  createdAt       DateTime @default(now())

  Payment Payment[]
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  investmentId    String?
  investment      Investment? @relation(fields: [investmentId], references: [id])
  txnRef          String
  amount          Float
  mode            PaymentMode
  razorpayOrderId String?
  upiRefId        String?
  status          PaymentStatus
  createdAt       DateTime @default(now())
}


enum KycStatus {
  PENDING      
  IN_PROGRESS  
  VERIFIED     
  REJECTED     
  EXPIRED      
}
enum KycType {
  VALIDATED    // Aadhaar-based KYC (can invest anywhere)
  REGISTERED   // Non-Aadhaar KYC (limited to existing AMCs)
  ON_HOLD      // Incomplete/failed KYC
}
enum KycSessionStatus {
  INITIATED       // Session created
  REDIRECTED      // User redirected to DigiLocker
  AUTHENTICATED   // User authenticated with DigiLocker
  COMPLETED       // KYC data fetched successfully
  FAILED          // KYC failed
  EXPIRED         // Session expired
}

enum InvestmentType {
  SIP
  LUMPSUM
}

enum SIPFrequency {
  MONTHLY
  QUARTERLY
  WEEKLY
}

enum SIPStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
}

enum PaymentMode {
  UPI
  NETBANKING
  AUTO_DEBIT
}

enum InvestmentStatus {
  PENDING
  SUCCESS
  FAILED
  REDEEMED
  CANCELLED
  ONGOING
}

enum EducationLevel {
  UNDERGRADUATE
  GRADUATE
  POST_GRADUATE
  DOCTORATE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

enum AnnualIncome {
  BELOW_2_LAKH
  TWO_TO_FIVE_LAKH
  FIVE_TO_TEN_LAKH
  TEN_TO_TWENTYFIVE_LAKH
  ABOVE_25_LAKH
  OTHER
}

enum IncomeSource {
  SALARIED
  SELF_EMPLOYED
  BUSINESS_OWNER
  STUDENT
  RETIRED
  OTHER
}

enum TaxResidency {
  INDIA
  NRI
  FOREIGN_NATIONAL
}
enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ResidentialStatus {
  RESIDENT_INDIVIDUAL
  NRI
  FOREIGN_NATIONAL
}

enum OccupationType {
  PRIVATE_SECTOR
  PUBLIC_SECTOR
  GOVERNMENT_SERVICE
  BUSINESS
  PROFESSIONAL
  STUDENT
  RETIRED
  HOUSEWIFE
  OTHER
}